# Test environment — used by vitest
# MONGO_URI is overridden by mongodb-memory-server in test/setup.ts
# but env.ts validates it before setup runs, so we provide a placeholder.
NODE_ENV=test
MONGO_URI=mongodb://localhost:27017/test-placeholder
JWT_SECRET=test-jwt-secret-for-vitest-only
JWT_REFRESH_SECRET=test-refresh-secret-for-vitest-only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
